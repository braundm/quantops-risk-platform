# Safe local-demo defaults. Copy to .env and change the token before shared use.
QUANTOPS_ENVIRONMENT=development
QUANTOPS_LOG_LEVEL=INFO
QUANTOPS_DEMO_MODE=true
QUANTOPS_DEMO_API_TOKEN=replace-with-a-local-random-token
QUANTOPS_DATABASE_URL=postgresql+asyncpg://quantops:quantops_local@postgres:5432/quantops
QUANTOPS_CORS_ORIGINS=http://localhost:5173
QUANTOPS_AI_PROVIDER=deterministic
QUANTOPS_EXTERNAL_LLM_API_KEY=
VITE_API_BASE_URL=http://localhost:8000/api/v1
