    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "jsdom": "^28.0.0",
    "typescript": "6.0.3",
